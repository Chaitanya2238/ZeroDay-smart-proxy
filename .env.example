# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control!

# Google Gemini API Key (get from https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (for backward compatibility)
# OPENAI_API_KEY=your_openai_key_here

# SMTP Email Configuration for Alerts
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_specific_password (not your regular password!)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Phase 2 Analyzer Settings
ANALYZER_CHECK_INTERVAL=5
ANALYZER_LOG_FILE=proxy.log
ANALYZER_ALERTS_FILE=phase2/alerts.json
ANALYZER_STATS_FILE=phase2/statistics.json
